---
import { promptCards, answerCards } from '../data/content.js';
const payload = JSON.stringify({ prompts: promptCards, answers: answerCards });
---

<div class="demo" id="hand-demo">
  <div class="demo__stage">
    <!-- Black prompt card + the played card slot -->
    <div class="demo__prompt-area">
      <div class="card card--black demo__prompt" id="demo-prompt">
        <span class="demo__kicker">Black card</span>
        <p class="demo__prompt-text" id="demo-prompt-text"></p>
        <span class="demo__logo">Cards Against Humanity</span>
      </div>

      <div class="demo__played" id="demo-played" data-empty="true">
        <div class="card demo__played-card" id="demo-played-card">
          <p id="demo-played-text"></p>
          <span class="demo__logo demo__logo--dark">Cards Against Humanity</span>
        </div>
        <p class="demo__played-hint" id="demo-played-hint">Play a card &rarr;</p>
      </div>
    </div>

    <!-- Result banner -->
    <div class="demo__result" id="demo-result" hidden>
      <span class="badge badge--gold" id="demo-verdict">The Card Czar approves.</span>
      <button class="btn btn--light btn--sm" id="demo-again">Deal a new hand</button>
    </div>

    <!-- The player's hand of white cards -->
    <div class="demo__hand" id="demo-hand" aria-label="Your hand of answer cards"></div>
  </div>
</div>

<script type="application/json" id="demo-data" set:html={payload}></script>

<style>
  .demo {
    background: var(--color-game-night-black);
    color: var(--color-card-white);
    border-radius: var(--radius-cards);
    padding: clamp(24px, 4vw, 44px);
    box-shadow: var(--shadow-subtle-2);
  }
  .demo__prompt-area {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    align-items: stretch;
  }

  .demo__prompt,
  .demo__played-card {
    min-height: 240px;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-cards);
    padding: 22px;
  }
  .demo__kicker {
    font-size: var(--text-caption);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    opacity: 0.5;
  }
  .demo__prompt-text {
    font-size: clamp(20px, 2.4vw, 26px);
    line-height: 1.25;
    font-weight: 800;
    margin-top: 10px;
    flex: 1;
  }
  .demo__logo {
    font-size: 11px;
    font-weight: 800;
    opacity: 0.6;
    margin-top: 12px;
  }
  .demo__logo--dark { color: var(--color-game-night-black); }

  /* Played slot */
  .demo__played { position: relative; }
  .demo__played-card {
    background: var(--color-card-white);
    color: var(--color-game-night-black);
    box-shadow: var(--shadow-subtle);
    height: 100%;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.35s ease;
  }
  .demo__played[data-empty='true'] .demo__played-card {
    opacity: 0;
    transform: translateY(20px) rotate(-3deg) scale(0.96);
    pointer-events: none;
  }
  .demo__played[data-empty='true'] {
    display: grid;
    place-items: center;
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.22);
    border-radius: var(--radius-cards);
  }
  .demo__played-hint {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-weight: 800;
    opacity: 0.4;
    pointer-events: none;
  }
  .demo__played[data-empty='false'] .demo__played-hint { display: none; }

  /* Result row */
  .demo__result {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 24px;
    flex-wrap: wrap;
    animation: shimmer-in 0.4s ease;
  }

  /* Hand */
  .demo__hand {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin-top: 32px;
  }
  .demo__answer {
    background: var(--color-card-white);
    color: var(--color-game-night-black);
    border-radius: var(--radius-cards);
    padding: 16px;
    min-height: 132px;
    text-align: left;
    font-size: var(--text-body-sm);
    font-weight: 800;
    line-height: 1.2;
    box-shadow: var(--shadow-subtle);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    display: flex;
    align-items: flex-start;
    animation: deal-in 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
  }
  .demo__answer:hover:not(:disabled) {
    transform: translateY(-10px) rotate(-2deg);
    box-shadow: var(--shadow-subtle), 0 10px 0 -4px rgba(255, 255, 255, 0.15);
  }
  .demo__answer:disabled { opacity: 0.25; cursor: default; }
  .demo__answer.is-picked {
    opacity: 0;
    transform: translateY(-40px) scale(0.9);
    pointer-events: none;
  }

  @media (max-width: 860px) {
    .demo__hand { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 600px) {
    .demo__prompt-area { grid-template-columns: 1fr; }
    .demo__prompt, .demo__played-card { min-height: 180px; }
    .demo__hand { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  type Data = { prompts: string[]; answers: string[] };

  const el = document.getElementById('demo-data');
  if (el) {
    const data: Data = JSON.parse(el.textContent || '{}');

    const promptText = document.getElementById('demo-prompt-text')!;
    const playedWrap = document.getElementById('demo-played')!;
    const playedText = document.getElementById('demo-played-text')!;
    const hand = document.getElementById('demo-hand')!;
    const result = document.getElementById('demo-result')!;
    const verdict = document.getElementById('demo-verdict')!;
    const again = document.getElementById('demo-again')!;

    const verdicts = [
      'The Card Czar approves.',
      'A bold and terrible choice.',
      'You win this round.',
      'Somehow, that works.',
      'Everyone groaned. You won.',
    ];

    const pick = <T,>(arr: T[]): T => arr[Math.floor(Math.random() * arr.length)];
    const sample = <T,>(arr: T[], n: number): T[] => {
      const copy = [...arr];
      const out: T[] = [];
      while (out.length < n && copy.length) {
        out.push(copy.splice(Math.floor(Math.random() * copy.length), 1)[0]);
      }
      return out;
    };

    function deal() {
      promptText.textContent = pick(data.prompts);
      playedWrap.setAttribute('data-empty', 'true');
      result.hidden = true;
      hand.innerHTML = '';

      sample(data.answers, 5).forEach((ans, i) => {
        const btn = document.createElement('button');
        btn.className = 'demo__answer';
        btn.style.animationDelay = `${i * 0.06}s`;
        btn.textContent = ans;
        btn.addEventListener('click', () => play(ans, btn));
        hand.appendChild(btn);
      });
    }

    function play(answer: string, btn: HTMLButtonElement) {
      // Disable the rest of the hand, fly the chosen card up
      hand.querySelectorAll<HTMLButtonElement>('.demo__answer').forEach((b) => {
        b.disabled = true;
        if (b === btn) b.classList.add('is-picked');
      });

      playedText.textContent = answer;
      setTimeout(() => playedWrap.setAttribute('data-empty', 'false'), 180);
      setTimeout(() => {
        verdict.textContent = pick(verdicts);
        result.hidden = false;
      }, 520);
    }

    again.addEventListener('click', deal);
    deal();
  }
</script>
